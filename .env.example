# Copy this file to .env and replace the placeholders with real values.
# .env is git-ignored and must never be committed.
DB_HOST=localhost
DB_NAME=pytracking
DB_USER=pytracking_user
DB_PASSWORD=replace-with-real-password
PYTRACKING_IP_SALT=generate-a-new-secret-hex-string

# Optional. Set to 1 to append receiver tracebacks to pytracking-debug.log
# beside the app; leave unset in normal operation.
# PYTRACKING_DEBUG=1
